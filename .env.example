RAGLENS_HOST=127.0.0.1
RAGLENS_ALLOWED_HOSTS=
RAGLENS_PORT=4177
RAGLENS_DATA_DIR=./data
RAGLENS_AUTO_SEED=true

# Optional hosted persistence. The default json mode has no database dependency.
RAGLENS_STORAGE_DRIVER=json
RAGLENS_DATABASE_URL=
RAGLENS_DATABASE_POOL_MAX=5
RAGLENS_DATABASE_SSL=true
RAGLENS_ALLOW_INSECURE_DATABASE_SSL=false

# Required when binding to a non-loopback host such as 0.0.0.0.
# Set RAGLENS_ALLOWED_HOSTS to comma-separated hostnames clients may use.
RAGLENS_ADMIN_TOKEN=
RAGLENS_ALLOW_UNSAFE_PUBLIC_BIND=false
RAGLENS_ALLOW_UNSAFE_PROVIDER_HTTP=false
RAGLENS_ALLOW_UNSAFE_OTEL_HTTP=false

# Optional live generation. Leave unset for deterministic local mode.
# Local vLLM on the host can use http://127.0.0.1:8000/v1.
# Docker Compose to host vLLM can use http://host.docker.internal:8000/v1.
RAGLENS_OPENAI_API_KEY=
RAGLENS_OPENAI_BASE_URL=https://api.openai.com/v1
RAGLENS_OPENAI_MODEL=gpt-4.1-mini
RAGLENS_OPENAI_TIMEOUT_MS=30000

# Optional cross-encoder reranking. Local keeps the built-in deterministic reranker.
# HTTP supports Cohere and TEI-compatible POST /rerank endpoints. ColBERT uses
# the same indexed-score contract and is traced as late-interaction reranking.
RAGLENS_RERANKER_PROVIDER=local
RAGLENS_RERANKER_BASE_URL=
RAGLENS_RERANKER_API_KEY=
RAGLENS_RERANKER_MODEL=raglens-heuristic-reranker-v1
RAGLENS_RERANKER_TIMEOUT_MS=30000

# Optional embedding provider. The default is local, deterministic, and dependency-free.
# Remote endpoints require explicit document egress consent.
RAGLENS_EMBEDDING_PROVIDER=local
RAGLENS_EMBEDDING_BASE_URL=
RAGLENS_EMBEDDING_API_KEY=
RAGLENS_EMBEDDING_MODEL=local-hash-embedding-v1
RAGLENS_EMBEDDING_TIMEOUT_MS=30000
RAGLENS_EMBEDDING_BATCH_SIZE=32
RAGLENS_ALLOW_REMOTE_EMBEDDING_EGRESS=false

# Optional query rewrite and decomposition through an OpenAI-compatible model.
# Local mode uses deterministic expansion with no network calls.
RAGLENS_QUERY_REWRITE_PROVIDER=local
RAGLENS_QUERY_REWRITE_BASE_URL=
RAGLENS_QUERY_REWRITE_API_KEY=
RAGLENS_QUERY_REWRITE_MODEL=
RAGLENS_QUERY_REWRITE_TIMEOUT_MS=15000
RAGLENS_ALLOW_REMOTE_QUERY_EGRESS=false

# Optional low-confidence fallback to a SearXNG-compatible JSON endpoint.
RAGLENS_WEB_FALLBACK_ENABLED=false
RAGLENS_WEB_SEARCH_BASE_URL=
RAGLENS_WEB_SEARCH_API_KEY=
RAGLENS_WEB_SEARCH_TIMEOUT_MS=10000
RAGLENS_WEB_SEARCH_MAX_RESULTS=5
RAGLENS_WEB_SEARCH_ALLOWED_DOMAINS=
RAGLENS_WEB_FALLBACK_MIN_CONFIDENCE=0.32
RAGLENS_ALLOW_REMOTE_WEB_QUERY_EGRESS=false

# Optional cost estimation for live providers. Fill with your provider's current per-1M-token prices.
RAGLENS_COST_INPUT_USD_PER_1M=0
RAGLENS_COST_OUTPUT_USD_PER_1M=0

# Optional OTLP/HTTP trace export.
RAGLENS_OTEL_EXPORT_URL=
RAGLENS_OTEL_SERVICE_NAME=raglens
RAGLENS_OTEL_TIMEOUT_MS=5000
RAGLENS_OTEL_HEADERS=
RAGLENS_OTEL_INCLUDE_CONTENT=false

# Optional layout-aware PDF extraction. Use an absolute path to a trusted local binary.
RAGLENS_PDF_TEXT_COMMAND=
RAGLENS_PDF_TEXT_ARGS=["-layout","{input}","-"]
RAGLENS_PDF_TEXT_TIMEOUT_MS=10000
